/**
 * robots.txt for EvaCode.
 * Catalog, product and brand pages stay crawlable for search and AI agents
 * (GPTBot, Google-Extended, ClaudeBot, PerplexityBot, etc. inherit User-agent *).
 * Do not add Disallow rules for those bots — only privatise account/checkout flows.
 */
export default [
  { UserAgent: '*' },
  { Allow: '/' },
  { Disallow: '/account/' },
  { Disallow: '/page/account/cart' },
  { Disallow: '/page/account/checkout' },
  { Disallow: '/page/order-success' },
  { Disallow: '/page/consult' },
  { Disallow: '/page/consult-success' },
  { CleanParam: 'utm_source&utm_medium&utm_campaign&utm_content&utm_term&yclid&ysclid&gclid&fbclid&from&_openstat /' },
  { BlankLine: true },
  { Sitemap: 'https://www.evacode.org/sitemap.xml' },
]
